# Copy to .env and fill in local values. Never commit .env.

# MySQL example:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/patentlens
# SQLite is supported for automated tests only:
# DATABASE_URL=sqlite:///./patentlens_test.db
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/patentlens

# Generate a long random string for JWT signing
SECRET_KEY=change-me-to-a-long-random-secret-32bytes+

FRONTEND_ORIGIN=http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Embedding models (semantic search only)
# Evaluate: AI-Growth-Lab/PatentSBERTa
# Comparison: BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# sentence-transformers | hash (hash is deterministic for tests / offline fixture)
EMBEDDING_BACKEND=sentence-transformers

PATENT_DATA_PATH=./data/raw/synthetic_patents_fixture.csv
FAISS_INDEX_PATH=./data/indexes/patents.faiss
FAISS_MAPPING_PATH=./data/indexes/vector_mapping.json
FAISS_META_PATH=./data/indexes/index_meta.json

UPLOAD_DIR=./storage/uploads
REPORT_DIR=./storage/reports
MAX_UPLOAD_MB=15

# Optional LLM (fail gracefully if unset)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

LOG_LEVEL=INFO
